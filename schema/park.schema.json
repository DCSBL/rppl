{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DCSBL/rppl/main/schema/park.schema.json",
  "title": "Rppl cable-park definition",
  "description": "Mirrors RpplCore/Sources/RpplCore/Parks/ParkModels.swift + ParkOpening.swift. Keep the two in sync by hand (see rppl repo issue #273).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "location"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Park.currentVersion in RpplCore. Bump only alongside a Swift-side schema migration."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case slug, unique across the repo. Must match the file name (RpplCore/Sources/RpplCore/Resources/Parks/<id>.yaml)."
    },
    "created_at": { "$ref": "#/$defs/date" },
    "updated_at": { "$ref": "#/$defs/date" },
    "based_on_updated_at": { "$ref": "#/$defs/date" },
    "based_on_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "On a user override: the bundled history.count it was edited from. Catches same-day bundled content changes that based_on_updated_at's day granularity can't."
    },
    "author": { "type": "string", "minLength": 1 },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "description"],
        "properties": {
          "date": { "$ref": "#/$defs/date" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "name": { "type": "string", "minLength": 1 },
    "location": { "$ref": "#/$defs/coordinate" },
    "address": { "type": "string", "minLength": 1 },
    "timezone": {
      "type": "string",
      "description": "IANA identifier, e.g. Europe/Amsterdam.",
      "pattern": "^[A-Za-z_]+(/[A-Za-z_-]+)+$"
    },
    "cables": {
      "type": "array",
      "items": { "$ref": "#/$defs/cable" }
    },
    "opening": { "$ref": "#/$defs/opening" },
    "phone": { "type": "string", "minLength": 1 },
    "email": {
      "type": "string",
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    },
    "website": { "$ref": "#/$defs/url" },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "amount", "currency"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "amount": { "type": "number", "maximum": 100000 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "per": { "type": "string", "minLength": 1 },
          "minutes": { "type": "integer", "minimum": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "url": { "$ref": "#/$defs/url" }
        }
      }
    },
    "description": { "type": "string" },
    "facilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "water_temperature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "station_id"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "station_id": { "type": "string", "minLength": 1 }
      }
    },
    "wakesys": {
      "type": "boolean",
      "description": "Whether this park's booking system is Wakesys. Optional, defaults to false."
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timeOrSunset": {
      "type": "string",
      "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d|sunset)$"
    },
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "day": {
      "type": "string",
      "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun", "weekdays", "weekend", "daily"]
    },
    "dateSelector": {
      "type": "object",
      "properties": {
        "months": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "days": {
          "type": "array",
          "items": { "$ref": "#/$defs/day" }
        },
        "from": { "$ref": "#/$defs/date" },
        "until": { "$ref": "#/$defs/date" },
        "dates": {
          "type": "array",
          "items": { "$ref": "#/$defs/date" }
        }
      }
    },
    "cable": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "length_m": { "type": "number", "exclusiveMinimum": 0 },
        "points": {
          "type": "array",
          "minItems": 2,
          "description": "A cable line needs at least a start and end point to be traceable.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lat", "lon"],
            "properties": {
              "lat": { "type": "number", "minimum": -90, "maximum": 90 },
              "lon": { "type": "number", "minimum": -180, "maximum": 180 },
              "start": { "type": "boolean" }
            }
          }
        }
      }
    },
    "openingRule": {
      "allOf": [
        { "$ref": "#/$defs/dateSelector" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["open", "close"],
          "properties": {
            "label": { "type": "string" },
            "months": true,
            "days": true,
            "from": true,
            "until": true,
            "dates": true,
            "open": { "$ref": "#/$defs/timeOrSunset" },
            "close": { "$ref": "#/$defs/timeOrSunset" },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "openingException": {
      "allOf": [
        { "$ref": "#/$defs/dateSelector" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "anyOf": [
            { "required": ["from"] },
            { "required": ["until"] },
            { "required": ["dates"] }
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "description": "hours (replaces the regular hours), closed, extra (added to the regular hours) or event (notice only). Unknown values are notices."
            },
            "label": { "type": "string" },
            "months": true,
            "days": true,
            "from": true,
            "until": true,
            "dates": true,
            "open": { "$ref": "#/$defs/timeOrSunset" },
            "close": { "$ref": "#/$defs/timeOrSunset" },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "openingSlot": {
      "allOf": [
        { "$ref": "#/$defs/dateSelector" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "start", "end"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string" },
            "months": true,
            "days": true,
            "from": true,
            "until": true,
            "dates": true,
            "start": { "$ref": "#/$defs/time" },
            "end": { "$ref": "#/$defs/time" }
          }
        }
      ]
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "booking": { "type": "string" },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/openingRule" }
        },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/openingSlot" }
        },
        "exceptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/openingException" }
        },
        "numbered": { "type": "boolean" },
        "booking_minutes": {
          "type": "array",
          "items": { "type": "integer", "exclusiveMinimum": 0 }
        },
        "note": { "type": "string" },
        "hours_unknown": { "type": "boolean", "description": "Deprecated and ignored: a park without rules or slots has unknown hours." }
      }
    }
  }
}
