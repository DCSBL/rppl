---
// Sample session (26 Sep, Project 7): 9 sets over 12:27-14:10. Decorative, same encodings as the app:
// timeline = real position/length, ring = riding share, bars = minutes per set.
const sessionMin = 103;
const sets = [
  { start: 0.026, min: 2.4 }, { start: 0.152, min: 4.4 }, { start: 0.261, min: 3.3 },
  { start: 0.358, min: 0.4 }, { start: 0.411, min: 4.6 }, { start: 0.543, min: 5.8 },
  { start: 0.748, min: 4.4 }, { start: 0.848, min: 3.1 }, { start: 0.932, min: 3.1 },
];
const R = 44, C = 2 * Math.PI * R, share = 0.31;
const maxMin = 6, bw = 22, gap = 8;
const icon = {
  flag: "M5 3v18M5 4h13l-2 4 2 4H5",
  lap: "M20 12a8 8 0 1 1-3-6.2M20 4v5h-5",
  speed: "M12 4a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 9 4-4",
  rider: "M4 20c4 0 5-2 8-2s4 2 8 2M13 4l-3 6 4 2-2 5",
};
---
<div class="viz">
  <section class="tile sets" style="--tint: var(--sets)">
    <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.flag} /></svg>Sets &amp; laps</h3>
    <div class="row">
      <div><div class="value">9</div><div class="caption">Sets</div></div>
      <div style="--tint: var(--laps)"><div class="value" style="color: var(--laps)">17</div><div class="caption">Laps</div></div>
    </div>
    <svg viewBox="0 0 100 6" preserveAspectRatio="none" class="timeline" role="img" aria-label="Nine sets spread across a session from 12:27 to 14:10">
      <rect width="100" height="6" rx="3" fill="var(--track)" />
      {sets.map((s) => <rect x={s.start * 100} width={Math.max((s.min / sessionMin) * 100, 0.5)} height="6" fill="var(--sets)" />)}
    </svg>
    <div class="caption ends"><span>12:27</span><span>14:10</span></div>
  </section>

  <section class="tile" style="--tint: var(--riding)">
    <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.rider} /></svg>Riding</h3>
    <div class="ring">
      <svg viewBox="0 0 110 110" role="img" aria-label="31 percent riding">
        <circle cx="55" cy="55" r={R} fill="none" stroke="var(--track)" stroke-width="10" />
        <circle cx="55" cy="55" r={R} fill="none" stroke="var(--riding)" stroke-width="10" stroke-linecap="round"
          stroke-dasharray={`${C * share} ${C}`} transform="rotate(-90 55 55)" />
        <text x="55" y="62" text-anchor="middle" font-size="22" font-weight="700" fill="var(--text)">31%</text>
      </svg>
      <div class="caption"><strong>31m 23s</strong> riding<br /><strong>1h 11m</strong> inactive</div>
    </div>
  </section>

  <section class="tile" style="--tint: var(--speed)">
    <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon.speed} /></svg>Speed</h3>
    <div class="value">41,3<small>km/h</small></div>
    <div class="caption">Max speed</div>
    <svg viewBox="0 0 100 6" preserveAspectRatio="none" class="timeline" role="img" aria-label="Average speed 31,3 of 41,3 kilometres per hour">
      <rect width="100" height="6" rx="3" fill="var(--track)" />
      <rect width={(31.3 / 41.3) * 100} height="6" rx="3" fill="var(--speed)" />
    </svg>
    <div class="caption">31,3 km/h average</div>
  </section>

  <section class="tile bars" style="--tint: var(--sets)">
    <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>Duration per set</h3>
    <svg viewBox={`0 0 ${sets.length * (bw + gap)} 120`} role="img" aria-label="Minutes per set: 2.4, 4.4, 3.3, 0.4, 4.6, 5.8, 4.4, 3.1, 3.1">
      {sets.map((s, i) => {
        const h = (s.min / maxMin) * 100;
        return <rect x={i * (bw + gap) + gap / 2} y={100 - h} width={bw} height={h} rx="3" fill="var(--sets)" />;
      })}
      {sets.map((_, i) => <text x={i * (bw + gap) + gap / 2 + bw / 2} y="116" text-anchor="middle" font-size="10" fill="var(--muted)">{i + 1}</text>)}
    </svg>
  </section>
</div>

<style>
  .viz { display: grid; grid-template-columns: 1fr; gap: 12px; }
  .row { display: flex; gap: 40px; margin-bottom: 12px; }
  .timeline { width: 100%; height: 14px; display: block; margin: 12px 0 4px; }
  .ends { display: flex; justify-content: space-between; font-size: 14px; }
  .ring { display: flex; align-items: center; gap: 16px; }
  .ring > svg { width: 120px; flex: none; }
  .bars > svg { width: 100%; max-height: 180px; }
  @media (min-width: 600px) {
    .viz { grid-template-columns: 1fr 1fr; }
    .sets, .bars { grid-column: 1 / -1; }
  }
</style>
