---
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const showcase = [
  { before: "Track", after: "Sessions", src: "logbook", tint: "var(--sets)", alt: "Rppl logbook: totals and a list of park-day sessions with sets and laps" },
  { before: "Analyse", after: "Progress", src: "session", tint: "var(--laps)", alt: "Session detail: sets and laps timeline, speed, riding share, distance and water temperature" },
  { before: "Find", after: "Spots", src: "parks", tint: "var(--speed)", alt: "Parks tab: nearby cable parks with opening hours and distance" },
];
const features = [
  { title: "Stay focussed", text: "Start recording your session when you are ready, the watch does the rest. The app auto-detects starts, stops and wipeouts.", watch: true },
  { title: "At a glance", text: "See important information about your session, like cable speed and set count." },
  { title: "Yours to keep", text: "Your data stays yours, you can view and export your data at any time, to do cool things or to brag about it. Your data is stored on your phone and in iCloud, not on our servers." },
];
---
<Base title="Rppl: cable-park wakeboarding tracker" description="Your Cablepark Buddy. Cable-park wakeboarding, recorded on Apple Watch. Automatic set detection, saved to Apple Health. No account, no subscription. Free, private and open source.">
  <header class="wrap hero">
    <img class="logo" src={`${base}/favicon.svg`} alt="" width="72" height="72" />
    <h1>Rppl</h1>
    <p class="lead">Your Cablepark Buddy</p>
    <p class="caption">Cable-park wakeboarding, recorded on Apple Watch. Automatic set detection. Saved to Apple Health. No account, no subscription. Free, private and open source.</p>
    <p class="cta"><span class="badge">Coming soon to the App Store</span></p>
  </header>

  <main class="wrap">
    <section class="showcase" aria-label="App screenshots">
      {showcase.map((s) => (
        <div class="row" style={`--tint: ${s.tint}`}>
          <h2>{s.before} <em>Your</em> {s.after}</h2>
          <div class="device phone">
            <img src={`${base}/shots/${s.src}.webp`} alt={s.alt} width="560" height="1215" loading="lazy" />
          </div>
        </div>
      ))}
    </section>

    <section aria-labelledby="why-h">
      <h2 id="why-h" class="sr-only">Built for the dock</h2>
      <div class="features">
        {features.map((f) => (
          <div class="tile">
            {f.watch && (
              <div class="device watch">
                <img src={`${base}/shots/watch.webp`} alt="Apple Watch riding view: distance, cable speed, laps, water temperature and heart rate" width="422" height="514" loading="lazy" />
              </div>
            )}
            <h3>{f.title}</h3>
            <p class="caption">{f.text}</p>
          </div>
        ))}
      </div>
    </section>
  </main>

  <footer class="wrap foot">
    <a href={`${base}/privacy/`}>Terms &amp; privacy</a>
    <span>Made by Duco Sebel in the Netherlands</span>
  </footer>
</Base>

<style>
  .hero { text-align: center; padding: 64px 0 24px; }
  .logo { margin: 0 auto 8px; }
  h1 { font-size: clamp(44px, 9vw, 72px); margin: 0; letter-spacing: -0.02em; }
  .lead { font-size: clamp(20px, 3.5vw, 28px); font-weight: 600; margin: 8px 0; }
  .cta { margin-top: 24px; }
  .badge { display: inline-block; padding: 10px 20px; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 600; }
  @media (prefers-color-scheme: dark) { .badge { color: #02070e; } }
  section { margin: 56px 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .row { display: flex; flex-direction: column; align-items: center; gap: 24px; margin: 72px 0; text-align: center; }
  .row h2 { font-size: clamp(34px, 7vw, 56px); line-height: 1.05; letter-spacing: -0.02em; margin: 0; }
  .row h2 em { font-style: normal; color: var(--tint); }
  @media (min-width: 760px) {
    .row { flex-direction: row; justify-content: center; gap: 72px; text-align: left; }
    .row > h2 { flex: 1 1 0; max-width: 380px; }
    .row > .device { flex: none; }
    .row:nth-child(even) { flex-direction: row-reverse; }
    .row:nth-child(even) > h2 { text-align: right; }
  }

  /* Simple CSS device frames: black bezel, side buttons as pseudo-elements. */
  .device { position: relative; background: #000; box-shadow: 0 0 0 1px #3a3a3c, 0 12px 36px rgb(3 59 79 / 0.25); }
  .device img { width: 100%; }
  .device::before, .device::after { content: ""; position: absolute; background: #2a2a2c; border-radius: 2px; }
  .phone { width: min(260px, 70vw); padding: 8px; border-radius: 44px; }
  .phone img { border-radius: 36px; }
  /* Left: action button + two volume buttons. Right: side button. */
  .phone::before { left: -3px; top: 14%; width: 3px; height: 22px; box-shadow: 0 46px 0 #2a2a2c, 0 86px 0 #2a2a2c; border-radius: 2px 0 0 2px; }
  .phone::after { right: -3px; top: 26%; width: 3px; height: 64px; border-radius: 0 2px 2px 0; }
  .watch { width: 168px; padding: 7px; border-radius: 42px; margin: 0 auto 20px; }
  .watch img { border-radius: 35px; }
  /* Digital Crown + side button on the right. */
  .watch::before { right: -5px; top: 24%; width: 5px; height: 30px; border-radius: 0 3px 3px 0; }
  .watch::after { right: -3px; top: 52%; width: 3px; height: 20px; border-radius: 0 2px 2px 0; }

  .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; }
  .features h3 { text-transform: none; letter-spacing: 0; font-size: 20px; color: var(--text); }
  .foot { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; padding: 24px 0 48px; border-top: 1px solid var(--hairline); color: var(--muted); font-size: 15px; }
</style>
