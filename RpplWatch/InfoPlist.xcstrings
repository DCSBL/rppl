    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl needs permission to start a water-sports workout so sensors stay active and heart rate can be recorded."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl heeft toestemming nodig om een watersport-workout te starten zodat sensors actief blijven en hartslag kan worden vastgelegd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl braucht die Erlaubnis, ein Wassersport-Workout zu starten, damit die Sensoren aktiv bleiben und die Herzfrequenz aufgezeichnet werden kann."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl saves your cable-park workout to Health when the session ends."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl slaat je kabelpark-workout op in Gezondheid wanneer de sessie eindigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl speichert dein Cable-Park-Workout in Health, wenn die Session endet."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl records GPS for the full park session, including when the wrist is down."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl neemt GPS op voor de hele parksessie, ook als de pols omlaag is."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl zeichnet GPS für die gesamte Park-Session auf, auch wenn das Handgelenk unten ist."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl records GPS during cable-park wakeboarding sessions."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl neemt GPS op tijdens kabelpark-wakeboardsessies."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl zeichnet GPS während Cable-Park-Wakeboard-Sessions auf."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl records device motion to help detect riding versus resting at the dock."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl neemt apparaatbeweging op om riding versus rusten bij de dock te helpen detecteren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl zeichnet die Gerätebewegung auf, um Riding und Pausen am Dock besser zu erkennen."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
