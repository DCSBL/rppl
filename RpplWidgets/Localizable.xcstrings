    "Touch and hold the widget, then choose Edit Widget. Once you log sessions, your most visited park shows here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the widget, then choose Edit Widget. Once you log sessions, your most visited park shows here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens le widget appuyé, puis choisis Modifier le widget. Dès que tu enregistres des sessions, ton park le plus visité s’affiche ici."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de widget ingedrukt en kies Pas widget aan. Zodra je sessies logt, tonen we je meest bezochte park."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das Widget gedrückt und wähle „Widget bearbeiten“. Sobald du Sessions loggst, erscheint hier dein am häufigsten besuchter Park."
          }
        }
      }
    },
