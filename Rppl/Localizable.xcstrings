        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open op iPhone Instellingen > Gezondheid > Toegang tot gegevens en apparaten > Rppl en zet de gewenste categorieën aan. Je kunt Gezondheid ook openen via de knop hieronder."
          }
        }
      }
