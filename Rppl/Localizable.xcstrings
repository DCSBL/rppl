          }
        }
      }
    },
    "Full size goes round the lake past every corner. A 2.0 cable runs back and forth between two towers. The direction follows the order you trace the points in." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full size goes round the lake past every corner. A 2.0 cable runs back and forth between two towers. The direction follows the order you trace the points in."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full size gaat rond het water, langs elke hoek. Een 2.0 cable gaat heen en weer tussen twee torens. De richting volgt de volgorde waarin je de punten tracet."
          }
        }
      }
    },
