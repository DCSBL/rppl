    "The hours riders can just show up. Add a row for every period with different hours: summer, winter, weekends, a holiday." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hours riders can just show up. Add a row for every period with different hours: summer, winter, weekends, a holiday."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tijden waarop riders gewoon kunnen komen. Voeg een rij toe voor elke periode met andere tijden: zomer, winter, weekenden, een feestdag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeiten, zu denen Rider einfach vorbeikommen können. Füge für jeden Zeitraum mit anderen Zeiten eine Zeile hinzu: Sommer, Winter, Wochenenden, einen Feiertag."
          }
        }
      }
    },
    "The hours then count on these dates only, for example Christmas Day or Easter Monday. Swipe a date to remove it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hours then count on these dates only, for example Christmas Day or Easter Monday. Swipe a date to remove it."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tijden gelden dan alleen op deze data, bijvoorbeeld eerste kerstdag of tweede paasdag. Veeg een datum weg om hem te verwijderen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zeiten gelten dann nur an diesen Daten, zum Beispiel am 1. Weihnachtstag oder Ostermontag. Wische ein Datum weg, um es zu entfernen."
          }
        }
      }
    },
