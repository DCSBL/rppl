    "Switch on the days these hours count on. With none or all switched on they count every day." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch on the days these hours count on. With none or all switched on they count every day."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de dagen aan waarop deze tijden gelden. Zonder dagen of met alle dagen aan gelden ze elke dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte die Tage ein, an denen diese Zeiten gelten. Ohne oder mit allen Tagen gelten sie jeden Tag."
          }
        }
      }
    },
    "Switch on the months these hours count in. With none or all switched on they count all year." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch on the months these hours count in. With none or all switched on they count all year."
