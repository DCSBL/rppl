    "Add every cable the park has. Trace it on the satellite map if the imagery is clear enough; a cable without a trace is fine too." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add every cable the park has. Trace it on the satellite map if the imagery is clear enough; a cable without a trace is fine too."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg elke cable van het park toe. Trace hem op de satellietkaart als het beeld duidelijk genoeg is; een cable zonder trace mag ook."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge jedes Cable des Parks hinzu. Trace es auf der Satellitenkarte, wenn das Bild klar genug ist; ein Cable ohne Trace ist aber auch in Ordnung."
          }
        }
      }
    },
