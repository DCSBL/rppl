            "value": "Op je apparaten"
          }
        }
      }
    },
    "Asked after your first session arrives from Watch. City names come from Watch GPS stored with each session, not from live iPhone location.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asked after your first session arrives from Watch. City names come from Watch GPS stored with each session, not from live iPhone location."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gevraagd nadat je eerste sessie vanaf de Watch binnenkomt. Stadsnamen komen uit Watch-GPS bij elke sessie, niet uit de live locatie van de iPhone."
          }
        }
      }
    },
