    "Uses an external, official water-monitoring service on parks with a nearby source, for the park screen. The reading is an estimate." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses an external, official water-monitoring service on parks with a nearby source, for the park screen. The reading is an estimate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt een externe, officiële waterdienst — bijvoorbeeld Rijkswaterstaat — bij parken met een nabije bron, voor het parkscherm. De waarde is een schatting."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzt bei Parks mit einer Messstelle in der Nähe einen externen, offiziellen Gewässerdienst für die Parkseite. Der Wert ist eine Schätzung."
          }
        }
      }
    },
    "Rppl fetches this from an external, official water-monitoring service. The reading is an estimate. You can change this later in Settings." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl fetches this from an external, official water-monitoring service. The reading is an estimate. You can change this later in Settings."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl haalt dit op bij een externe, officiële waterdienst — bijvoorbeeld Rijkswaterstaat. De waarde is een schatting. Je kan dit later aanpassen in Instellingen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl ruft dies bei einem externen, offiziellen Gewässerdienst ab. Der Wert ist eine Schätzung. Du kannst das später in den Einstellungen ändern."
          }
        }
      }
    },
    "Import from iCloud Drive or a session export of raw data. Imported sessions appear in the logbook." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import from iCloud Drive or a session export of raw data. Imported sessions appear in the logbook."
