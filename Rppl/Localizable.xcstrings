    },
    "Keeps your phone logbook in your iCloud Drive as backup, which can be restored." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps your phone logbook in your iCloud Drive as backup, which can be restored."
