    "Rppl fetches new park info from GitHub, a website where developers share files. GitHub can see your IP address; nothing else is sent. You can change this in Info." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl fetches new park info from GitHub, a website where developers share files. GitHub can see your IP address; nothing else is sent. You can change this in Info."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl haalt nieuwe parkinfo op bij GitHub, een website waar ontwikkelaars bestanden delen. GitHub ziet je IP-adres; er wordt verder niets verstuurd. Je kunt dit aanpassen bij Info."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl ruft neue Parkinfos von GitHub ab, einer Website, auf der Entwickler Dateien teilen. GitHub sieht deine IP-Adresse; sonst wird nichts gesendet. Du kannst das unter „Info“ ändern."
          }
        }
      }
    },
