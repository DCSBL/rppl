    "Delete from This iPhone hides the session in Rppl here. Delete from iPhone and iCloud permanently removes it from all devices. This cannot be undone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete from This iPhone hides the session in Rppl here. Delete from iPhone and iCloud permanently removes it from all devices. This cannot be undone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderen van deze iPhone verbergt de session hier in Rppl. Verwijderen van iPhone en iCloud verwijdert de session permanent van alle apparaten. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Von diesem iPhone löschen“ blendet die Session hier in Rppl aus. „Von iPhone und iCloud löschen“ entfernt sie dauerhaft von allen Geräten. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
