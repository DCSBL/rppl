    "On iPhone, open Settings > Health > Data Access & Devices > Rppl, then turn on the categories you want to allow.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone, open Settings > Health > Data Access & Devices > Rppl, then turn on the categories you want to allow."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open op iPhone Instellingen > Gezondheid > Gegevenstoegang en apparaten > Rppl en zet de categorieën aan die je wilt toestaan."
          }
        }
      }
    },
    "On iPhone, open Settings > Privacy & Security > Location Services > Rppl, then choose While Using the App.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone, open Settings > Privacy & Security > Location Services > Rppl, then choose While Using the App."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open op iPhone Instellingen > Privacy en beveiliging > Locatievoorzieningen > Rppl en kies Bij gebruik van de app."
          }
        }
      }
    },
    "On iPhone, open Settings > Privacy & Security > Motion & Fitness, then enable Rppl.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone, open Settings > Privacy & Security > Motion & Fitness, then enable Rppl."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open op iPhone Instellingen > Privacy en beveiliging > Beweging en fitness en schakel Rppl in."
          }
        }
      }
    },
    "Optional. Lets the iPhone read Health data for companion views. Workouts are recorded on Apple Watch, and turning this off does not block syncing sessions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Lets the iPhone read Health data for companion views. Workouts are recorded on Apple Watch, and turning this off does not block syncing sessions."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Laat de iPhone Gezondheidsgegevens lezen voor begeleidende weergaven. Workouts worden op Apple Watch opgenomen, en dit uitzetten blokkeert het synchroniseren van sessies niet."
          }
        }
      }
    },
    "Optional. Lets the iPhone show map context for your sessions. City and spot names already come from Watch GPS stored with each session, so sync still works if you turn this off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Lets the iPhone show map context for your sessions. City and spot names already come from Watch GPS stored with each session, so sync still works if you turn this off."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Laat de iPhone kaartcontext voor je sessies tonen. Stads- en spotnamen komen al uit Watch-GPS die bij elke sessie is opgeslagen, dus sync werkt nog steeds als je dit uitzet."
          }
        }
      }
    },
    "Optional. Lets the iPhone use motion data when reviewing a session. It is not required to sync sessions from the Watch.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Lets the iPhone use motion data when reviewing a session. It is not required to sync sessions from the Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel. Laat de iPhone bewegingsgegevens gebruiken bij het bekijken van een sessie. Dit is niet nodig om sessies vanaf de Watch te synchroniseren."
          }
        }
      }
    },
