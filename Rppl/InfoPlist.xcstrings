    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl reads heart rate and energy during cable-park sessions so you can review them on iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl lit ta fréquence cardiaque et ton énergie pendant tes sessions au cable park pour que tu puisses les revoir sur iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl leest hartslag en energie tijdens kabelparksessies zodat je ze op iPhone kunt bekijken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl liest Herzfrequenz und Energie während deiner Cable-Park-Sessions, damit du sie auf dem iPhone ansehen kannst."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl uses Health on iPhone for companion session views. Workouts are saved from Apple Watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl utilise Santé sur iPhone pour l’affichage des sessions. Les entraînements sont enregistrés depuis l’Apple Watch."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl gebruikt Gezondheid op iPhone voor sessieweergave. Workouts worden vanaf Apple Watch opgeslagen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl nutzt Health auf dem iPhone für die Session-Ansichten. Workouts werden von der Apple Watch gespeichert."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl uses your location to sort cable parks by distance and to fill in a spot when you add a park or session."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl utilise ta position pour trier les cable parks par distance et remplir un lieu quand tu ajoutes un park ou une session."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl gebruikt je locatie om cable parks op afstand te sorteren en een plek in te vullen als je een park of sessie toevoegt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl nutzt deinen Standort, um Cable Parks nach Entfernung zu sortieren und einen Spot einzutragen, wenn du einen Park oder eine Session hinzufügst."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl uses motion APIs when reviewing session context on iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl utilise les API de mouvement quand tu revois le contexte d’une session sur iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl gebruikt bewegings-API’s bij het bekijken van sessiecontext op iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl nutzt Bewegungs-APIs, wenn du den Kontext einer Session auf dem iPhone ansiehst."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
