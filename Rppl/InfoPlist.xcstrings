    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl reads heart rate and energy during cable-park sessions so you can review them on iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl leest hartslag en energie tijdens kabelpark sessions zodat je ze op iPhone kunt bekijken."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl uses Health on iPhone for companion session views. Workouts are saved from Apple Watch."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl gebruikt Gezondheid op iPhone voor session-weergave. Workouts worden vanaf Apple Watch opgeslagen."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl may use location to display session tracks."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl kan locatie gebruiken om session-sporen te tonen."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl shows GPS tracks from Apple Watch sessions on the map and sorts cable parks by distance from you."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl toont GPS-sporen van Apple Watch-sessions op de kaart en sorteert cable parks op afstand tot jou."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl uses motion APIs when reviewing session context on iPhone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rppl gebruikt bewegings-API’s bij het bekijken van session-context op iPhone."
          }
        }
      }
    }
  },
  "version" : "1.0"
